*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.xdv
*.synctex(busy)

# LaTeX 临时文件
*.dvi
*.ps

# 编辑器和 IDE 配置文件
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Claude AI 配置文件
.claude/

# Kiro 配置文件
.kiro/

# Git 自动推送脚本（包含个人配置信息）
1-git-push-auto.bat

# Windows 批处理文件
*.bat

# 其他临时文件
*.tmp
*.bak
*.backup
